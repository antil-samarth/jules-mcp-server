# Jules API key (server-side only). Create one at https://jules.google.com/settings
# This is used as the `x-goog-api-key` header when calling https://jules.googleapis.com/v1alpha
JULES_API_KEY=

# Shared secret that MCP clients must send as `Authorization: Bearer <MCP_AUTH_TOKEN>`.
# Use at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is unset (or shorter than 16 chars) the endpoint refuses ALL requests with a 500.
MCP_AUTH_TOKEN=

# OAuth 2.0 / 2.1 credentials (for Gemini Web App at gemini.google.com).
# Generate random client id & secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# OPTIONAL: Explicit public base URL override (e.g. https://my-app.vercel.app).
# If unset, automatically derived from the request's Host / x-forwarded-proto headers.
APP_URL=

# OPTIONAL: comma-separated browser origins allowed to call /api/mcp via CORS,
# e.g. https://my-app.example.com,http://localhost:5173  (use * to allow any origin).
# Leave empty if you only use non-browser clients (Gemini CLI, curl, ...).
# Note: CORS is not authentication; the Bearer token is still required on every non-OPTIONS request.
MCP_CORS_ORIGINS=
